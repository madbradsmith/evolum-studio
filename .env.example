# Evolum Studio environment template — copy to .env and fill values
# Never commit the real .env

# --- Flask ---
SECRET_KEY=replace-with-a-long-random-string
PORT=7000

# --- Database (SQLite) ---
# Local default: ./evolum.db
# On Render with a persistent disk, point at /var/data/evolum.db
DATABASE_PATH=evolum.db

# --- TMDB (optional, for comparable films enrichment) ---
TMDB_API_TOKEN=

# --- FAL (image generation, paid; OK to leave blank during dev) ---
FAL_API_KEY=

# --- Stripe (Session 2; checkout + webhook) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_WRITERS_ROOM=
STRIPE_PRICE_PROD_COMPANY=
